
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Reset password</title>

    <!-- Main CSS file -->
    <link rel="stylesheet" href="/css/style.css">

    <!-- Redux library for state management -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/redux/5.0.1/redux.min.js"></script>

    <!-- Redux store configuration -->
    <script src="/js/redux-store.js"></script>

    <!-- Shared functionality used across pages -->
    <script src="/js/common.js" defer></script>

    <!-- Password reset functionality -->
    <script src="/js/reset-password.js" defer></script>
</head>

<body>
    <!-- Header with ShopNest logo -->
    <header>
        <a class="logo" href="/">
            Shop<span>Nest</span>
        </a>
    </header>

    <!-- Main password reset section -->
    <main class="section narrow">
        <h1>Reset password</h1>

        <!-- Displays success messages or errors -->
        <p id="message"></p>

        <!-- Password reset form -->
        <form id="resetForm" class="panel">

            <!-- New password input -->
            <label>
                New password (8+ characters)
                <input
                    type="password"
                    id="password"
                    minlength="8"
                    required
                >
            </label>

            <!-- Submit the new password -->
            <button>Update password</button>

        </form>
    </main>
</body>
</html>

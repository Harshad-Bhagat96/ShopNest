
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>ShopNest</title>

    <!-- Main CSS file -->
    <link rel="stylesheet" href="/css/style.css">

    <!-- Redux library for state management -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/redux/5.0.1/redux.min.js"></script>

    <!-- Redux store configuration -->
    <script src="/js/redux-store.js"></script>

    <!-- Common functionality shared across pages -->
    <script src="/js/common.js" defer></script>

    <!-- Home page functionality -->
    <script src="/js/app.js" defer></script>
</head>

<body>
    <!-- Header: logo, product search, and navigation -->
    <header>
        <a class="logo" href="/">
            Shop<span>Nest</span>
        </a>

        <!-- Product search form -->
        <form id="searchForm">
            <input
                id="search"
                placeholder="Search products"
            >
            <button>Search</button>
        </form>

        <!-- Navigation links -->
        <nav>
            <a href="/profile.html">Profile</a>
            <a href="/orders.html">Orders</a>

            <a href="/cart.html">
                Cart <b id="cartCount">0</b>
            </a>

            <!-- Login link, updated by common.js -->
            <a id="authLink" href="/login.html">Login</a>

            <!-- Hidden until the user is logged in -->
            <button
                id="logout"
                class="secondary hidden"
                type="button"
            >
                Logout
            </button>
        </nav>
    </header>

    <!-- Main page content -->
    <main>
        <!-- Hero section: introductory banner -->
        <section class="hero">
            <div>
                <small>THE EVERYDAY EDIT</small>

                <h1>
                    Good finds.<br>
                    Better everyday.
                </h1>

                <p>
                    Useful essentials for work, home, and life.
                </p>

                <a class="button" href="#products">
                    Explore products
                </a>
            </div>

            <!-- Decorative hero element -->
            <div class="hero-art">S</div>
        </section>

        <!-- Product collection section -->
        <section class="section">
            <div class="heading">
                <div>
                    <small>OUR COLLECTION</small>
                    <h2 id="title">Popular products</h2>
                </div>

                <!-- Product category filter -->
                <select id="category">
                    <option>All</option>
                    <option>Electronics</option>
                    <option>Fashion</option>
                    <option>Home</option>
                </select>
            </div>

            <!-- Displays messages, errors, or status information -->
            <p id="message"></p>

            <!-- app.js renders product cards inside this container -->
            <div id="products" class="grid"></div>
        </section>
    </main>

    <!-- Footer -->
    <footer>
        Learning project · Use Razorpay test keys while developing.
    </footer>
</body>
</html>


<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Profile</title>

    <!-- Main CSS file -->
    <link rel="stylesheet" href="/css/style.css">

    <!-- Redux library for state management -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/redux/5.0.1/redux.min.js"></script>

    <!-- Redux store configuration -->
    <script src="/js/redux-store.js"></script>

    <!-- Shared functionality used across pages -->
    <script src="/js/common.js" defer></script>

    <!-- Profile page functionality -->
    <script src="/js/profile.js" defer></script>
</head>

<body>
    <!-- Header and navigation -->
    <header>
        <a class="logo" href="/">
            Simple<span>Store</span>
        </a>

        <nav>
            <a href="/">Shop</a>
            <a href="/orders.html">Orders</a>
        </nav>
    </header>

    <!-- Main profile section -->
    <main class="formwrap">

        <!-- Profile form -->
        <form id="profile" class="panel">
            <h1>Your profile</h1>

            <!-- User's name -->
            <label>
                Name
                <input name="name" required>
            </label>

            <!-- Email is displayed but cannot be edited -->
            <label>
                Email
                <input name="email" disabled>
            </label>

            <!-- User's delivery address -->
            <label>
                Delivery address
                <textarea name="address" rows="4"></textarea>
            </label>

            <!-- Submit updated profile information -->
            <button class="button">Save profile</button>

            <!-- Displays success messages or errors -->
            <p id="message"></p>
        </form>

    </main>
</body>
</html>
